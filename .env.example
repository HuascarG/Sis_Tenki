# ============================================================
# TENKI — Plantilla de Variables de Entorno (.env.example)
# ============================================================

APP_ENV=production

# ── URL Base de la Aplicación ───────────────────────────────
APP_URL=https://tu-dominio-o-render.com/

# ── Base de Datos (MySQL / Aiven / Host) ─────────────────────
DB_HOST=mysql-xxxx.aivencloud.com
DB_PORT=3306
DB_NAME=tenki_db
DB_USER=avnadmin
DB_PASS=tu_password_secreta
DB_CHARSET=utf8mb4
DB_SSL_MODE=false

# ── Servidor de Correo (SMTP / PHPMailer) ────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_clave_de_aplicacion
MAIL_FROM=tu_correo@gmail.com
MAIL_FROM_NAME="TENKI Sistema"
